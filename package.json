{
  "name": "murmur-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "storage:init": "tsx --env-file=.env scripts/storage-init.ts",
    "storage:cleanup": "tsx --env-file=.env scripts/cleanup.ts",
    "openapi": "tsx scripts/openapi.ts",
    "codegen": "npm run openapi && openapi-generator-cli generate -i openapi/openapi.json -g kotlin -o clients/kotlin -c codegen.json --global-property apiTests=false,modelTests=false",
    "test": "tsx --env-file=.env --test --test-concurrency=1 tests/*.test.ts",
    "test:kotlin": "tsx --env-file=.env scripts/test-kotlin.ts",
    "format": "prettier --write src scripts tests drizzle.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1141.0",
    "@aws-sdk/s3-request-presigner": "3.1141.0",
    "@hono/node-server": "2.1.1",
    "@hono/zod-openapi": "1.6.3",
    "@scalar/hono-api-reference": "0.12.6",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.9",
    "pg": "8.23.0",
    "sharp": "0.35.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "2.41.0",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
