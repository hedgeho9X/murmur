{
  "openapi": "3.0.3",
  "info": {
    "title": "MyAPP API",
    "version": "0.1.0"
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "CreatedPost": {
        "type": "object",
        "properties": {
          "post": {
            "$ref": "#/components/schemas/Post"
          },
          "message": {
            "$ref": "#/components/schemas/UserMessage"
          }
        },
        "required": [
          "post",
          "message"
        ]
      },
      "Post": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "title",
          "created_at",
          "updated_at"
        ]
      },
      "UserMessage": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "post_id": {
            "type": "string",
            "format": "uuid"
          },
          "turn_id": {
            "type": "string",
            "format": "uuid"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "role": {
            "type": "string",
            "enum": [
              "user"
            ]
          },
          "content": {
            "$ref": "#/components/schemas/UserContent"
          },
          "tool_call_id": {
            "nullable": true
          }
        },
        "required": [
          "id",
          "post_id",
          "turn_id",
          "created_at",
          "role",
          "content",
          "tool_call_id"
        ]
      },
      "UserContent": {
        "type": "object",
        "properties": {
          "parts": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/TextPart"
                },
                {
                  "$ref": "#/components/schemas/ImagePart"
                }
              ],
              "discriminator": {
                "propertyName": "type",
                "mapping": {
                  "text": "#/components/schemas/TextPart",
                  "image": "#/components/schemas/ImagePart"
                }
              }
            },
            "minItems": 1,
            "maxItems": 30
          }
        },
        "required": [
          "parts"
        ],
        "additionalProperties": false
      },
      "TextPart": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "text"
            ]
          },
          "text": {
            "type": "string",
            "maxLength": 100000
          }
        },
        "required": [
          "type",
          "text"
        ],
        "additionalProperties": false
      },
      "ImagePart": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "image"
            ]
          },
          "image_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "type",
          "image_id"
        ],
        "additionalProperties": false
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "CreatePostRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "nullable": true,
            "minLength": 1,
            "maxLength": 200
          },
          "content": {
            "$ref": "#/components/schemas/UserContent"
          }
        },
        "required": [
          "content"
        ],
        "additionalProperties": false
      },
      "PostPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Post"
            }
          },
          "next_cursor": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "items",
          "next_cursor"
        ]
      },
      "PostDetail": {
        "type": "object",
        "properties": {
          "post": {
            "$ref": "#/components/schemas/Post"
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Message"
            }
          }
        },
        "required": [
          "post",
          "messages"
        ]
      },
      "Message": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/UserMessage"
          },
          {
            "$ref": "#/components/schemas/AssistantMessage"
          },
          {
            "$ref": "#/components/schemas/ToolMessage"
          }
        ],
        "discriminator": {
          "propertyName": "role",
          "mapping": {
            "user": "#/components/schemas/UserMessage",
            "assistant": "#/components/schemas/AssistantMessage",
            "tool": "#/components/schemas/ToolMessage"
          }
        }
      },
      "AssistantMessage": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "post_id": {
            "type": "string",
            "format": "uuid"
          },
          "turn_id": {
            "type": "string",
            "format": "uuid"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "role": {
            "type": "string",
            "enum": [
              "assistant"
            ]
          },
          "content": {
            "$ref": "#/components/schemas/AssistantContent"
          },
          "tool_call_id": {
            "nullable": true
          }
        },
        "required": [
          "id",
          "post_id",
          "turn_id",
          "created_at",
          "role",
          "content",
          "tool_call_id"
        ]
      },
      "AssistantContent": {
        "type": "object",
        "properties": {
          "parts": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/TextPart"
                },
                {
                  "$ref": "#/components/schemas/ImagePart"
                },
                {
                  "$ref": "#/components/schemas/ToolCallPart"
                }
              ],
              "discriminator": {
                "propertyName": "type",
                "mapping": {
                  "text": "#/components/schemas/TextPart",
                  "image": "#/components/schemas/ImagePart",
                  "tool_call": "#/components/schemas/ToolCallPart"
                }
              }
            }
          },
          "finish_reason": {
            "type": "string",
            "enum": [
              "stop",
              "tool_call",
              "interrupted",
              "error"
            ]
          }
        },
        "required": [
          "parts",
          "finish_reason"
        ],
        "additionalProperties": false
      },
      "ToolCallPart": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "tool_call"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "arguments": {
            "type": "object",
            "additionalProperties": {
              "nullable": true
            }
          }
        },
        "required": [
          "type",
          "id",
          "name",
          "arguments"
        ],
        "additionalProperties": false
      },
      "ToolMessage": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "post_id": {
            "type": "string",
            "format": "uuid"
          },
          "turn_id": {
            "type": "string",
            "format": "uuid"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "role": {
            "type": "string",
            "enum": [
              "tool"
            ]
          },
          "content": {
            "$ref": "#/components/schemas/ToolContent"
          },
          "tool_call_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "post_id",
          "turn_id",
          "created_at",
          "role",
          "content",
          "tool_call_id"
        ]
      },
      "ToolContent": {
        "type": "object",
        "properties": {
          "parts": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/TextPart"
                },
                {
                  "$ref": "#/components/schemas/ImagePart"
                },
                {
                  "$ref": "#/components/schemas/JsonPart"
                }
              ],
              "discriminator": {
                "propertyName": "type",
                "mapping": {
                  "text": "#/components/schemas/TextPart",
                  "image": "#/components/schemas/ImagePart",
                  "json": "#/components/schemas/JsonPart"
                }
              }
            }
          },
          "is_error": {
            "type": "boolean"
          }
        },
        "required": [
          "parts",
          "is_error"
        ],
        "additionalProperties": false
      },
      "JsonPart": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "json"
            ]
          },
          "data": {
            "nullable": true,
            "description": "Any JSON value"
          }
        },
        "required": [
          "type",
          "data"
        ],
        "additionalProperties": false
      },
      "RenamePostRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "nullable": true,
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "title"
        ],
        "additionalProperties": false
      },
      "UploadResponse": {
        "type": "object",
        "properties": {
          "image": {
            "$ref": "#/components/schemas/Image"
          },
          "upload_url": {
            "type": "string",
            "format": "uri"
          },
          "expires_in": {
            "type": "integer"
          }
        },
        "required": [
          "image",
          "upload_url",
          "expires_in"
        ]
      },
      "Image": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "content_type": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer"
          },
          "width": {
            "type": "integer",
            "nullable": true
          },
          "height": {
            "type": "integer",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "ready"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "content_type",
          "size_bytes",
          "width",
          "height",
          "status",
          "created_at"
        ]
      },
      "UploadRequest": {
        "type": "object",
        "properties": {
          "content_type": {
            "type": "string",
            "enum": [
              "image/jpeg",
              "image/png",
              "image/webp"
            ]
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10485760
          }
        },
        "required": [
          "content_type",
          "size_bytes"
        ],
        "additionalProperties": false
      },
      "ImageUrl": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "expires_in": {
            "type": "integer"
          }
        },
        "required": [
          "url",
          "expires_in"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/v1/posts": {
      "post": {
        "operationId": "createPost",
        "tags": [
          "Posts"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "required": true,
            "name": "Idempotency-Key",
            "in": "header"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePostRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedPost"
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Error",
